APP_NAME="Eli Catering"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE="Asia/Tehran"
APP_URL=http://localhost:8000
APP_LOCALE=fa

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=eli_catering
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database

FILESYSTEM_DISK=public

# --- Restaurant-specific values (read by config/restaurant.php) ---
# Centralized here on purpose per the spec: one place to update if any of
# these change, instead of hunting through Blade templates.
RESTAURANT_NAME="Eli Catering"
RESTAURANT_PHONE="+989120000000"
RESTAURANT_WHATSAPP="+989120000000"
RESTAURANT_INSTAGRAM="eli.catering"
RESTAURANT_ADDRESS=""
RESTAURANT_ORDER_HOURS="۱۰ صبح تا ۲ بعدازظهر"
